# Copy this file to .env.local and fill in real values.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: restrict magic-link sign-in to one or more company domains.
# Comma-separated, no @ prefix. Leave blank to allow any email.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=

# AI analysis
# Production should call OpenAI for real. Set to "true" only for local/demo
# fixture analysis with zero API cost.
USE_AI_FIXTURES=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
